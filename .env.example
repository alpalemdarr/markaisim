# ==============================================================================
# VERCEL POSTGRES / NEON / SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Vercel'de yayına aldığınızda Storage sekmesinden Postgres (Neon) eklediğinizde
# Vercel bu değişkenleri otomatik olarak tanımlar.
# Veya harici bir PostgreSQL (Supabase, Neon, Railway vb.) kullanıyorsanız
# aşağıdaki DATABASE_URL satırını projenizin Vercel Environment Variables kısmına ekleyin.
# ==============================================================================

# Standart PostgreSQL Bağlantı Dizgisi:
DATABASE_URL="postgres://username:password@ep-host.region.neon.tech/neondb?sslmode=require"

# Vercel Postgres kullanılıyorsa Vercel tarafından otomatik atanan değişkenler:
# POSTGRES_URL="postgres://..."
# POSTGRES_PRISMA_URL="postgres://..."

# NOT: Yerel geliştirmede DATABASE_URL tanımlanmazsa, sistem otomatik olarak
# .data/db.json yerel depolama motorunu kullanarak sıfır kurulumla çalışır!
